{
  "name": "mommy-error-asmr",
  "displayName": "Error Mommy Sound Extension",
  "description": "Plays soothing mommy ASMR voice when your code fails — powered by Fish Audio TTS",
  "version": "0.1.3",
  "publisher": "raditted",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/raditted/Error_Mommy_Sound_Extension.git"
  },
  "bugs": {
    "url": "https://github.com/raditted/Error_Mommy_Sound_Extension/issues"
  },
  "homepage": "https://github.com/raditted/Error_Mommy_Sound_Extension#readme",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "error",
    "sound",
    "asmr",
    "tts",
    "fish-audio",
    "mommy",
    "voice",
    "funny"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mommyErrorAsmr",
          "title": "Mommy ASMR",
          "icon": "media/icon-activitybar.svg"
        }
      ]
    },
    "views": {
      "mommyErrorAsmr": [
        {
          "type": "webview",
          "id": "mommyErrorAsmr.sidebarView",
          "name": "Mommy Says...",
          "icon": "media/icon-activitybar.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "mommyErrorAsmr.toggle",
        "title": "Mommy ASMR: Toggle Sound On/Off"
      },
      {
        "command": "mommyErrorAsmr.testSound",
        "title": "Mommy ASMR: Test Sound"
      },
      {
        "command": "mommyErrorAsmr.clearCache",
        "title": "Mommy ASMR: Clear Audio Cache"
      },
      {
        "command": "mommyErrorAsmr.showOutput",
        "title": "Mommy ASMR: Show Output Logs"
      }
    ],
    "configuration": {
      "title": "Error Mommy Sound Extension",
      "properties": {
        "mommyErrorAsmr.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable mommy error sounds"
        },
        "mommyErrorAsmr.fishAudioApiKey": {
          "type": "string",
          "default": "",
          "description": "Your Fish Audio API key (create one at https://fish.audio/app/api-keys/)"
        },
        "mommyErrorAsmr.fishAudioModelId": {
          "type": "string",
          "default": "60bd8f0f5bbc462a8fa1686dd81af336",
          "description": "Fish Audio voice model ID for the mommy voice (default: 60bd8f0f5bbc462a8fa1686dd81af336)"
        },
        "mommyErrorAsmr.ttsModel": {
          "type": "string",
          "default": "s2.1-pro-free",
          "enum": [
            "s2.1-pro-free",
            "s2-pro",
            "s2.1-pro",
            "s1"
          ],
          "enumDescriptions": [
            "S2.1 Pro Free (Default, recommended for free tier)",
            "S2 Pro (High quality pro model)",
            "S2.1 Pro (Latest pro model)",
            "S1 (Legacy model)"
          ],
          "description": "Fish Audio TTS engine model"
        },
        "mommyErrorAsmr.cooldownSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Minimum seconds between error sounds to prevent spam and overlapping audio (0 to disable)"
        },
        "mommyErrorAsmr.triggerSource": {
          "type": "string",
          "default": "all",
          "enum": [
            "notebook",
            "task",
            "terminal",
            "debug",
            "all"
          ],
          "enumDescriptions": [
            "Only trigger on notebook cell execution errors",
            "Only trigger on build task failures",
            "Only trigger on terminal output errors (e.g. python, java, javac)",
            "Only trigger on debug/run session execution errors (e.g. F5, Run Java, Debug Python)",
            "Trigger on all error sources"
          ],
          "description": "Which execution errors should trigger the sound"
        },
        "mommyErrorAsmr.characterImage": {
          "type": "string",
          "default": "",
          "description": "Path to a custom character image (e.g. /home/user/Pictures/mommy.png, ~/Pictures/mommy.png, or C:\\Users\\user\\Pictures\\mommy.png). Leave empty for default."
        },
        "mommyErrorAsmr.showImage": {
          "type": "boolean",
          "default": true,
          "description": "Show character image panel when error occurs"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "package": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "lint": "eslint src",
    "test": "node ./dist/test/runTest.js",
    "vsce:package": "vsce package --no-dependencies",
    "vsce:publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}